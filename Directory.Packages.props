<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Pinned to 2.x: the ASP.NET Core 10 OpenAPI source generator is incompatible with
         Microsoft.OpenApi 3.x (IOpenApiMediaType.Example became read-only). 3.x lands with
         ASP.NET Core 11, and Microsoft.AspNetCore.OpenApi 10.0.x declares
         Microsoft.OpenApi (>= 2.12.0 && < 3.0.0), so 3.x also trips NU1608. Also carries
         the GHSA-v5pm-xwqc-g5wc patch. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Test-only: hosts the /v1 API in memory so the endpoints are exercised over real HTTP
         (routing, status codes, content types, model binding) without binding a port. Version
         tracks the ASP.NET Core 10 packages above. Never referenced by a shipped artifact. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Sarif.Sdk" Version="5.9.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>
</Project>
