{
  "name": "threatmodelforge-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Threat Model Forge Studio — the React Flow DFD canvas over the .NET engine's /v1 API. Built into the API's wwwroot by the .NET build.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.vitest.json --noEmit && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "stage:wasm": "dotnet publish ../ThreatModelForge.Wasm/ThreatModelForge.Wasm.csproj -c Release -o obj/wasm-pub && rm -rf public/wasm && mkdir -p public/wasm && cp -R obj/wasm-pub/wwwroot/_framework public/wasm/_framework",
    "gen:api": "openapi-typescript ../ThreatModelForge.Api/openapi/v1.json -o src/dfd/engine/schema.d.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
