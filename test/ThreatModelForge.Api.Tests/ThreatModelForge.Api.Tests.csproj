<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <RootNamespace>ThreatModelForge.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThreatModelForge.Api\ThreatModelForge.Api.csproj" />
    <ProjectReference Include="..\..\src\ThreatModelForge.Engine\ThreatModelForge.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Fixtures\additional-matchers.json" Link="Fixtures\additional-matchers.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Fixtures\threat-dragon-v2.json" Link="Fixtures\threat-dragon-v2.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\rule-packs\*.tmrules.json" Link="Fixtures\RulePacks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\rule-packs\starter-model.tmforge.json" Link="Fixtures\RulePacks\starter-model.tmforge.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
